# ==============================================
# Partner Frontend - Production Environment
# ==============================================
# Copy this file to .env.production on your VPS
# and fill in the values.
# ==============================================

# API Base URL (required)
NEXT_PUBLIC_API_BASE_URL=https://main.chargeghar.com/api

# Docker Hub image tag (optional, defaults to 'latest')
# IMAGE_TAG=latest

# Docker Hub username (used by docker-compose.yml)
# DOCKERHUB_USERNAME=your-dockerhub-username
